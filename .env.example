# Opencode auth mounted via env vars (AGENTS.md:79 - no direct LLM_API_KEY in code)
# Copy to .env and fill
# OPENCODE_API_KEY=
# OPENCODE_MODEL=provider/model  # e.g., openrouter/free-model, anthropic/claude-3.5-sonnet, ollama/llama3
# For free models (Big Pickle etc.), use opencode providers: see `sudo docker compose run --rm banana opencode models`
# Example free: OPENCODE_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct:free  or  ollama/llama3

# Telegram — get token from @BotFather on Telegram: /newbot -> copy token
# https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_token_from_botfather_here
# Optional: restrict to your chat
# TELEGRAM_ALLOWED_CHAT_ID=
